// Configuración del Worker de PlanVuelo para Cloudflare (se instala solo al subir cambios a GitHub).
// Las credenciales de autorouter NO van aquí: son secretos guardados en Cloudflare.
{
  "name": "planvuelo",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Conserva las variables y secretos creados en el panel de Cloudflare al instalar desde GitHub.
  "keep_vars": true
}
